rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // כל משתמש יכול לקרוא ולכתוב רק את הנתונים של עצמו
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // רשימת המשתמשים: כל אחד כותב רק את הרשומה של עצמו (מייל, שם, תאריכים).
    // רק המנהל יכול לקרוא את הרשימה. במקום ADMIN_UID שמים את ה-User UID של המנהל.
    match /members/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == 'ADMIN_UID';
    }
  }
}
