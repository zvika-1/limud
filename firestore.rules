rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // כל משתמש יכול לקרוא ולכתוב רק את הנתונים של עצמו
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // רשימת המשתמשים: כל אחד כותב רק את הרשומה של עצמו (מייל, שם, תאריכים).
    // רק המנהל יכול לקרוא את הרשימה. (המזהה כאן הוא ה-User UID של המנהל)
    match /members/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == 'O1zNmKklxyaD7ysMQIsBUpv390D3';
    }
    // בקשות להוספת ספרים: כל משתמש מחובר יכול לשלוח בקשה בשמו. רק המנהל קורא ומוחק.
    match /requests/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text is string && request.resource.data.text.size() < 2000;
      allow read, delete: if request.auth != null && request.auth.uid == 'O1zNmKklxyaD7ysMQIsBUpv390D3';
    }
  }
}
